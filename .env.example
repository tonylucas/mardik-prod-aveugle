# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM (Azure AI Inference)
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=Kimi-K2.6

# OpenTelemetry — OTLP/gRPC collector (Jaeger all-in-one exposes 4317)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mardik
# Écrit les prompts, les réponses et les résultats d'outil dans les spans.
# Désactivé par défaut : un message client est une donnée personnelle, et le
# backend de traces est un tiers. À n'activer que sur un environnement de debug.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Session replay corpus
MARDIK_SESSIONS_DIR=sessions
